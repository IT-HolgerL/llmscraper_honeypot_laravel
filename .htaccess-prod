# ==========================
# Domain: planetary-quantum.site
# ==========================
# --- robots.txt: direkt ausliefern (keine Weiterleitung) ---
RewriteCond %{HTTP_HOST} ^planetary-quantum\.site$ [NC]
RewriteRule ^robots\.txt$ /TU_Berlin/llmscraper_honeypot_laravel/planetary-quantum/robots.txt [L,END]

# --- Haupt-Redirect: alles (außer wenn bereits die PHP-Datei angefragt wurde) ---
RewriteCond %{HTTP_HOST} ^planetary-quantum\.site$ [NC]
# Wenn der Browser die PHP-Datei direkt angefordert hat (Original-Request), NICHT umschreiben
RewriteCond %{THE_REQUEST} !planetary-quantum\.php [NC]
# Wenn die Anfrage nicht bereits eine interne Rewrite-Antwort ist (safeguard)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.*)$ /TU_Berlin/llmscraper_honeypot_laravel/planetary-quantum/planetary-quantum.php [L,QSA,END]

